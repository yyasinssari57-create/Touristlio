# Touristlio — Production ortam şablonu
# Sunucuya kopyalayın: cp .env.production.example .env
# Ardından JWT_SECRET, ADMIN_PASSWORD ve SMTP bilgilerini gerçek değerlerle doldurun.

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL (Supabase) — required. Render disk is ephemeral; do not use SQLite in production.
# Direct: postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres
# If IPv6/5432 fails, Session pooler (5432): postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# URL-encode @ in the password as %40. Do not commit real credentials.
DATABASE_URL=

# Supabase Storage — user/admin image uploads (Render disk is ephemeral)
# Service key is secret; never put it in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
TRUST_PROXY=true

# Zorunlu — npm run generate:jwt-secret ile üretin (min 32 karakter)
JWT_SECRET=

# Admin — güçlü, benzersiz şifre kullanın
ADMIN_EMAIL=admin@touristlio.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Canlı site — CSRF, e-posta ve sitemap. Tercih edilen host: www (KRİTİK-5/7)
# CORS: tek origin yeterli; apex otomatik eklenir.
CORS_ORIGIN=https://www.touristlio.com
SITE_URL=https://www.touristlio.com
# Cloudflare zaten apex→www 301 yapıyorsa ve çift yönlendirme oluşursa:
# DISABLE_WWW_REDIRECT=true

# Çerezler — production'da secure otomatik açılır; Render HTTPS arkasında false yapmayın
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# İsteğe bağlı — statik asset cache-bust (boşsa package.json sürümü + dosya mtime kullanılır)
APP_VERSION=

# Rate limits (production önerilen)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60
ADMIN_TOOL_RATE_LIMIT_MAX=10
LIVE_DATA_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_MAX=10

# E-posta doğrulama açıkken SMTP zorunludur
REQUIRE_EMAIL_VERIFICATION=true

CACHE_TTL_MS=300000
SITEMAP_ON_START=true
# Auto-seed places/admin when DB has fewer than 10 places (always when empty).
# Does NOT delete existing users — only INSERT OR REPLACE places, ensure admin, demo blogs if empty.
SEED_ON_START=true

# Render Starter+ with disk mount: set true (render.yaml default). Free plan: leave unset — admin shows ephemeral warning.
# STORAGE_PERSISTENT=true

# SMTP — Brevo (smtp-relay.brevo.com) — npm run verify:smtp ile test edin
# SMTP_USER = Brevo giriş e-postası | SMTP_PASS = SMTP anahtarı (API anahtarı değil)
# Gönderen doğrula: Brevo → Ayarlar > Gönderenler → touristlio.info@gmail.com ekleyip doğrulayın
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key-here
SMTP_FROM=touristlio.info@gmail.com

WEATHER_CACHE_MS=1800000
AFFILIATE_ENABLED=false
LIVE_DATA_CRON=true

# İsteğe bağlı
UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200
PLACES_MIN_COUNT=800

# Google reCAPTCHA v3 (invisible). Empty = skip (forms still work).
# Set BOTH in production to enable. Never commit real keys.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5
FORM_RATE_LIMIT_MAX=3

# Analytics (DÜŞÜK-6). Empty = no GA4 / no Search Console tag.
# First-party page views still require cookie consent (tl_cookie_ok).
# GA4: https://analytics.google.com → Admin → Data streams → Measurement ID (G-XXXXXXXX)
# Search Console: URL prefix property → HTML tag token (google-site-verification content)
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Tiola anti-bot (ORTA-4) — Redis for shared vote limits. Memory fallback if unset.
# REDIS_URL=redis://127.0.0.1:6379
TIOLA_VOTE_RATE_LIMIT_MAX=5
