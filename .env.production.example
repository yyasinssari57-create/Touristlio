# Touristlio — Production ortam şablonu
# Sunucuya kopyalayın: cp .env.production.example .env
# Ardından JWT_SECRET, ADMIN_PASSWORD ve SMTP bilgilerini gerçek değerlerle doldurun.

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Render / Railway gibi reverse proxy arkasında true yapın (rate-limit ve güvenli IP için)
TRUST_PROXY=true

# Zorunlu — npm run generate:jwt-secret ile üretin (min 32 karakter)
JWT_SECRET=

# Admin — güçlü, benzersiz şifre kullanın
ADMIN_EMAIL=admin@touristlio.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Canlı site
CORS_ORIGIN=https://touristlio.com
SITE_URL=https://touristlio.com

# Rate limits (production önerilen)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60
ADMIN_TOOL_RATE_LIMIT_MAX=10
LIVE_DATA_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_MAX=10

# E-posta doğrulama açıkken SMTP zorunludur
REQUIRE_EMAIL_VERIFICATION=true

CACHE_TTL_MS=300000
SITEMAP_ON_START=true

# SMTP — Brevo (smtp-relay.brevo.com) — npm run verify:smtp ile test edin
# SMTP_USER = Brevo giriş e-postası | SMTP_PASS = SMTP anahtarı (API anahtarı değil)
# Gönderen doğrula: Brevo → Ayarlar > Gönderenler → touristlio.info@gmail.com ekleyip doğrulayın
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key-here
SMTP_FROM=touristlio.info@gmail.com

WEATHER_CACHE_MS=1800000
AFFILIATE_ENABLED=false
LIVE_DATA_CRON=true

# İsteğe bağlı
UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200
PLACES_MIN_COUNT=800
