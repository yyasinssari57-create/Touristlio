# Touristlio — Hetzner VPS ortam şablonu
# Kurulum: cp deploy/hetzner/.env.hetzner.example .env
# Ardından aşağıdaki boş/örnek değerleri gerçek bilgilerle doldurun.
# Düzenleme: nano .env

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# SQLite — kalıcı disk yolu (sunucuda önce klasör oluşturulur)
DATABASE_PATH=/var/lib/touristlio/data/touristlio.db

# Nginx reverse proxy arkasında true olmalı (IP ve rate-limit için)
TRUST_PROXY=true

# Kalıcı depolama — Hetzner VPS'te true
STORAGE_PERSISTENT=true

# Zorunlu — sunucuda: npm run generate:jwt-secret
# En az 32 karakter; oturumların redeploy sonrası geçerli kalması için sabit tutun
JWT_SECRET=

# Admin hesabı — ilk giriş /admin için
ADMIN_EMAIL=admin@touristlio.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Canlı site adresi — tarayıcıdaki URL ile birebir aynı (sondaki / yok)
# CSRF ve e-posta linkleri buna bağlıdır; yanlış değer 403 hatası verir
SITE_URL=https://touristlio.com
CORS_ORIGIN=https://touristlio.com

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

APP_VERSION=

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60
ADMIN_TOOL_RATE_LIMIT_MAX=10
LIVE_DATA_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_MAX=10

REQUIRE_EMAIL_VERIFICATION=true

CACHE_TTL_MS=300000
SITEMAP_ON_START=true
SEED_ON_START=true

# SMTP — Brevo önerilir: https://www.brevo.com
# SMTP_USER = Brevo giriş e-postası | SMTP_PASS = SMTP anahtarı (API anahtarı DEĞİL)
# Gönderen: Brevo → Ayarlar → Gönderenler → SMTP_FROM adresini doğrulayın
# Test: npm run verify:smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key-here
SMTP_FROM=touristlio.info@gmail.com

WEATHER_CACHE_MS=1800000
AFFILIATE_ENABLED=false
LIVE_DATA_CRON=true

UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200
PLACES_MIN_COUNT=800
