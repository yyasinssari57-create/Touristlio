{
  "name": "touristlio",
  "version": "2.0.0",
  "description": "Touristlio — global travel discovery with Tiola reviews (V2 Pro)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/scripts/start-prod.js",
    "dev": "node --watch server/index.js",
    "generate:jwt-secret": "node server/scripts/generate-jwt-secret.js",
    "verify:smtp": "node server/scripts/verify-smtp.js",
    "seed": "node server/seed.js",
    "admin:ensure": "node server/scripts/ensure-admin.js",
    "places:merge": "node server/scripts/build-places-500.js",
    "places:enrich": "node server/scripts/enrich-content.js",
    "places:fetch-photos": "node server/scripts/fetch-photos.js",
    "places:validate": "node server/scripts/validate-places.js",
    "places:fix-images": "node server/scripts/fix-places-images.js",
    "logo:extract": "node server/scripts/extract-nav-logo.js",
    "images:convert": "node server/scripts/convert-static-images.js",
    "verify:images": "node server/scripts/verify-images.js",
    "verify:jsonld": "node server/scripts/verify-jsonld.js",
    "verify:stats": "node server/scripts/verify-homepage-stats.js",
    "verify:errors": "node server/scripts/verify-error-boundary.js",
    "verify:forms": "node server/scripts/verify-form-security.js",
    "verify:tiolas": "node server/scripts/verify-tiola-visibility.js",
    "verify:filters": "node server/scripts/verify-search-filters.js",
    "verify:pagination": "node server/scripts/verify-pagination.js",
    "verify:votes": "node server/scripts/verify-anti-bot.js",
    "verify:indexes": "node server/scripts/verify-indexes.js",
    "verify:blog": "node server/scripts/verify-blog-pages.js",
    "verify:user-system": "node server/scripts/verify-user-system.js",
    "verify:passwords": "node server/scripts/verify-password-hash.js",
    "verify:www": "node server/scripts/verify-www-redirect.js",
    "verify:legal": "node server/scripts/verify-legal-placeholders.js",
    "verify:csp": "node server/scripts/verify-csp.js",
    "verify:admin-role": "node server/scripts/verify-admin-role.js",
    "verify:mobile": "node server/scripts/verify-mobile-layout.js",
    "verify:a11y": "node server/scripts/verify-accessibility.js",
    "verify:skeleton": "node server/scripts/verify-skeleton.js",
    "verify:links": "node server/scripts/verify-broken-links.js",
    "verify:cleanup": "node server/scripts/verify-code-cleanup.js",
    "verify:analytics": "node server/scripts/verify-analytics.js",
    "places:run-all": "node server/scripts/run-all.js",
    "sitemap": "node server/scripts/generate-sitemap.js",
    "live-data:refresh": "node -e \"require('./server/db').initDb().then(() => require('./server/services/liveDataService').refreshAllPlaces()).then((n) => { console.log('done', n); process.exit(0); }).catch((e) => { console.error(e); process.exit(1); })\"",
    "backup:db": "node server/scripts/backup-db.js",
    "uploads:migrate": "node server/scripts/migrate-uploads-to-supabase.js"
  },
  "engines": {
    "node": ">=20.18.0 <23"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.7.1",
    "sharp": "^0.35.4",
    "web-vitals": "^4.2.4"
  }
}
