PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (Supabase). Required — SQLite is no longer used.
# Direct (db.*:5432). Password @ must be URL-encoded as %40.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# If direct IPv6/5432 is unreachable, use Session pooler (port 5432), not Transaction 6543:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Storage (uploaded photos). Service key is secret — never commit real values.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth — production: npm run generate:jwt-secret (min 32 chars; see .env.production.example)
JWT_SECRET=change-this-to-a-long-random-string

ADMIN_EMAIL=yasin@touristlio.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Yasin

# CORS — local: http://localhost:3000 | production: https://touristlio.com
CORS_ORIGIN=http://localhost:3000
# Local dev: http://localhost:3000 — CSRF ve e-posta linkleri SITE_URL'e bağlıdır
SITE_URL=http://localhost:3000

# Rate limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60
ADMIN_TOOL_RATE_LIMIT_MAX=10
ADMIN_ANALYTICS_RATE_LIMIT_MAX=600
LIVE_DATA_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_MAX=30

# Güvenlik
REQUIRE_EMAIL_VERIFICATION=true

# CSP — production'da otomatik açık; inline script'ler nonce ile çalışır.
# CSP_FORCE=true      → development'ta da uygula (yerel test için)
# CSP_REPORT_ONLY=true → engellemeden yalnızca konsola ihlal bildir (güvenli açılış)
# CSP_FORCE=
# CSP_REPORT_ONLY=

# INSTAGRAM_URL=https://www.instagram.com/your-handle
# JSON-LD TravelAgency sameAs — yalnızca gerçek hesap varsa doldur

# Cache TTL (ms) — default 5 min; places list uses 60s internally
CACHE_TTL_MS=300000

# Sitemap — set false to skip auto-regenerate on server start
SITEMAP_ON_START=true

# SMTP — Brevo önerilir (ücretsiz katman): https://www.brevo.com
# Kurulum: hesap aç → Ayarlar > SMTP & API > SMTP anahtarı oluştur (API anahtarı DEĞİL)
# Gönderen doğrula: Brevo → Ayarlar > Gönderenler → touristlio.info@gmail.com ekleyip doğrulayın (SMTP_FROM ile aynı adres)
# Test: npm run verify:smtp — dev'de boş bırakılabilir (e-posta log'a yazılır)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-brevo-smtp-key-here
SMTP_FROM=touristlio.info@gmail.com
# Optional. Render may block SMTP 587; Brevo HTTP API (xkeysib-...) sends over 443.
# BREVO_API_KEY=

# Weather (Open-Meteo)
WEATHER_CACHE_MS=1800000

# Affiliate links hidden unless true
AFFILIATE_ENABLED=false

# Live data cron (set false to disable)
LIVE_DATA_CRON=true

# Unsplash (optional — npm run places:fetch-photos)
UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200

# Validation
PLACES_MIN_COUNT=800

# Google reCAPTCHA v3 (invisible). Leave empty in dev — forms still work.
# Production: create a v3 key pair at https://www.google.com/recaptcha/admin
# and set BOTH. Do not commit real secrets.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5
FORM_RATE_LIMIT_MAX=3

# Analytics (DÜŞÜK-6 / v2 ORTA-3). Empty until a real GA4 ID exists — do not invent one.
# After cookie accept (tl_cookie_ok=1 / cookie_consent=accepted), gtag loads only if this is set.
# Production: create a GA4 property at https://analytics.google.com then set on Render:
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Search Console HTML tag from URL-prefix verification (not a tracking cookie).
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Tiola anti-bot (ORTA-4). Redis URL for shared 5/min vote limits across instances.
# Leave empty in local/dev — in-memory fallback is used.
# REDIS_URL=redis://127.0.0.1:6379
TIOLA_VOTE_RATE_LIMIT_MAX=5
# TIOLA_VOTE_RATE_WINDOW_MS=60000
