PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Auth — production: use openssl rand -hex 32 (min 32 chars, never use the default below)
JWT_SECRET=change-this-to-a-long-random-string

ADMIN_EMAIL=yasin@touristlio.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Yasin

# CORS — production: https://touristlio.com
CORS_ORIGIN=http://localhost:3000
SITE_URL=https://touristlio.com

# Rate limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60
ADMIN_TOOL_RATE_LIMIT_MAX=10

# Cache TTL (ms) — default 5 min; places list uses 60s internally
CACHE_TTL_MS=300000

# Sitemap — set false to skip auto-regenerate on server start
SITEMAP_ON_START=true

# SMTP (optional — password reset / email verify; logs only if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@touristlio.com

# Weather (Open-Meteo)
WEATHER_CACHE_MS=1800000

# Affiliate links hidden unless true
AFFILIATE_ENABLED=false

# Live data cron (set false to disable)
LIVE_DATA_CRON=true

# Unsplash (optional — npm run places:fetch-photos)
UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200

# Validation
PLACES_MIN_COUNT=800
