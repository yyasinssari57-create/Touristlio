PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Auth
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=yasin@touristlio.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Yasin

# CORS — production: https://touristlio.com
CORS_ORIGIN=http://localhost:3000
SITE_URL=https://touristlio.com

# Rate limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SEARCH_RATE_LIMIT_MAX=60

# Cache TTL (ms) — default 5 min
CACHE_TTL_MS=300000

# V2 — Weather (Open-Meteo, optional cache override ms)
WEATHER_CACHE_MS=1800000

# V2 — Affiliate links hidden unless true
AFFILIATE_ENABLED=false

# V2 — Live data cron (set false to disable)
LIVE_DATA_CRON=true

# Unsplash (optional — npm run places:fetch-photos)
UNSPLASH_ACCESS_KEY=
UNSPLASH_DELAY_MS=1200

# Validation
PLACES_MIN_COUNT=800
